use #rawNumbers

let html = $import(html)

hline: $html.Hr(class: pages--flow--hline)
newline: $html.Br()
newpar: $html.Div($empty, class: pages--flow--par)
ref newpage: $html.Div($empty, style:(breakBefore: page))

vfill: $html.Div($empty, class: pages--flow--vfill)
glue: $html.Div($empty, class: pages--flow--glue)

pageNumber: $html.Span(, class:pages--to-eval--pagenumber)
whitePage: $newpage$html.Div(,)$newpage

Align: macro(content, ?center, ?left, ?right)
	if center and left or center and right or left and right
		raise Cannot use two align flags together.
	elseif not center and not left and not right
		raise Muse give at least one align flag.
	end

	let flag = $(center and "center" or right and "right" or left and "left")
	@html.Div(class: pages--flow--align pages--flow--align-$flag)
		$content
	end
end

hspace: macro(...args)
	if len(args)>1
		raise To many arguments
	end
	@html.Div($empty)
		class: pages--flow--hspace
		style: do
			display: inline-block
			width: calc($(args[1]? or 1) * var(--space-1x))
		end
	end
end

vspace: macro(...args)
	if len(args)>1
		raise To many arguments
	end
	@html.Div($empty)
		class: pages--flow--vspace
		style: do
			height: calc($(args[1]? or 1) * var(--space-1x))
		end
	end
end