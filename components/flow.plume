use #future(all)
let html = $import(html)

hline: $html.Hr(class:pages--flow--hline)
newline: $html.Div($empty, class:pages--flow--newline)
newpage: $html.Div($empty, class:pages--flow--newpage)

hspace: $html.Span($empty, class: pages--flow--hspace)
vspace: $html.Div($empty, class: pages--flow--vspace)