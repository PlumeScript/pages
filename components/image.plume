let html   = $import(html)
let base64 = $import(../utils/base64)

// Take an url or an `os.Path` object. *(workaround to get the path relative to the user document)*
// In case of an `os.Path` object, image will be saved inside the final document.
// `mode` can be `block` (default), `inline`, `float-left` or `float-right`
// Support svg, png, jpg, avif, webp and bmp images format.
image: macro(path, width:, height:, caption:, mode: block)
	let src

	if not Table.find(("block", "inline", "float-left", "float-right"), mode)
		raise Unknown mode "$mode"
	end

	if type(path) == "string"
		if path.startsWith("https://")
			set src = $path
		else
			raise Given `path` must be an url or an `os.Path` object, not a `string`.
		end
	else
		if not path.exists()
			raise Image "$path" not found.
		end

		let ext = $path.getExtension().lower()
		let MIME = if Table.find(("png", "gif", "jpeg", "avif", "bmp", "webp"), ext)
			image/$ext
		elseif ext == "jpg" 
			image/jpeg
		elseif ext == "svg" 
			image/svg+xml
		else
			raise Unsupported extention "$ext".
		end
		
		set src = data\:$MIME;base64,$base64($path)
	end
	
	
	return @html.Tag(Figure)
		class: do
			pages--image--wrapper
			\spages--image--$mode
			if mode != "block"
				\spages--as-inline
			end
		end
		- do
			@html.Img
				class: pages--image
				src: $src
				if width
					width: $width
				end
				if height
					height: $height
				end

				if not width and not height
					style: if mode == "inline"
						(height: 1em)
					elseif mode == "block"
						(maxWidth: 100%, height: auto)
					else
						(width: auto)
					end
				end
			end
			if caption
				@html.Tag(Figcaption, class: pages--image--figcaption)
					$caption
				end
			end
		end
	end
end