use #future(all)
let html = $import(html)
let css  = $import(css)

let context = $import(../context)
let applyFormatNumbering from $import(../utils/counterLabel)

let numberTracking = (0, 0, 0, 0, 0, 0)
let listDeep = 0

ref List: macro(bullet: •, Number indent: 4, columns:, c:, formatNumbering:, fn:, ?ordered, ...items)
	if columns and c
		raise Cannot use both "columns" and "c" parameters.
	end
	if formatNumbering and fn
		raise Cannot use both "formatNumbering" and "c" fn.
	end

	set columns         = $ Number(columns or c or 1)
	set formatNumbering = $ formatNumbering or fn

	let style = @css.css
		gridTemplateColumns: repeat($columns, 1fr)
		paddingLeft: calc($indent * var(--space-1x))
	end

	meta fragment: macro()
		if ordered
			set listDeep += 1
		end

		@html.Div(class: pages--list, style: $style)
			for item in items
				@html.Div(class: pages--list--item)
					if ordered
						@html.Span(class: pages--list--item--bullet)
							set numberTracking[listDeep] += 1
							$ applyFormatNumbering(listDeep, formatNumbering, numberTracking)
						end
					elseif bullet
						@html.Span(class: pages--list--item--bullet)
							$bullet
						end
					end
					@html.Span(class: pages--list--item--body)
						$item
					end
				end
			end
		end

		if ordered
			for i in seq(listDeep, len(numberTracking))
				set numberTracking[i] = 0
			end
			set listDeep -= 1
		end
	end
end

oList: macro(...args)
	$List(?ordered, ...args)
end