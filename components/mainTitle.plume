use #future(all)
let html = $import(html)

// Intended to be on first page or used as cover
// By default, put title - subtitle - author one below the other, and date/institution on one line and smaller.
// All fields are optionnals.
MainTitle: macro(title:, subtitle:, author:, date:, institution:)
	@html.Div(class: pages--main-title pages--to-space)
		$html.H1($title, class: pages--main-title--title)
		if subtitle
			$html.H2($subtitle, class: pages--main-title--subtitle)
		end
		if author
			$html.P($author, class: pages--main-title--author)
		end
		if date or institution
			@html.Div(class: class: pages--main-title--author-date-wrapper)
				if date
					$html.P($date, class: pages--main-title--date)
				end
				if institution
					$html.P($institution, class: pages--main-title--institution)
				end
			end
		end
	end
end