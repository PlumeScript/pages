use #rawNumbers

let html    = $import(html)
let context = $import(../context)
let global = $import(../global)

// Rendering a math formula
// `processor` could be `tex` *(for `LaTeX` syntax)* or `ascii` *(for `asciimath` syntax)*. If empty, use contextual variable `formulaProcessor`.
// `?display` renders it as a block.
formula: macro(content, processor:, ?display, ?inlineDisplay)
	set processor = $ processor or context.formulaProcessor()
	if processor != "tex" and processor != "ascii"
		raise Unsuported processor `$processor`.
	end

	@html.Span
		class: do
			- pages--math
			$("pages--math-display"): $(display or inlineDisplay)
			$("pages--math-display--inline"): $inlineDisplay
		end
		- @html.Script
			type: math/$processor$((display or inlineDisplay) and " ;mode=display")
			class: pages--as-inline

			if plume.locale() == "fr"
				let rpl = if processor == "ascii"
					\\\s
				else
					~
				end
				// To get correct decimal separator
				if type(content) == "number"
					set content = $content.localize()
				end
				// A trailing space gives a non-digit tail to a run ending the
				// formula; both math processors ignore trailing whitespace.
				set content = $content\s
				// Drop inert spaces already between digits: the built-in fr number
				// formatting uses plain spaces, and both processors ignore them.
				while content.find("([0-9])%s+([0-9])", ?rich)
					set content = $content.replace(([0-9])%s+([0-9]), %1%2,?rich)
				end
				// Split fraction digits (right after a decimal comma) into singles
				// so the grouping below cannot touch them.
				while content.find(",([0-9])([0-9])", ?rich) or content.find("([0-9]) ([0-9])([0-9])", ?rich)
					if content.find(",([0-9])([0-9])", ?rich)
						set content = $content.replace(\,([0-9])([0-9]), \,%1 %2,?rich)
					else
						set content = $content.replace(([0-9]) ([0-9])([0-9]), %1 %2 %3,?rich)
					end
				end
				// Group runs of 4+ digits by threes, right-anchored: the leftmost
				// window of 4 adjacent digits followed by a non-digit is the run's
				// tail, so each pass inserts the separator before the last three.
				while content.find("[0-9][0-9][0-9][0-9]", ?rich)
					set content = $content.replace(([0-9])([0-9])([0-9])([0-9])%s*([^0-9]), %1$rpl%2%3%4%5,?rich)
				end
				// Rejoin the split fraction digits.
				while content.find("([0-9]) ([0-9])", ?rich)
					set content = $content.replace(([0-9]) ([0-9]), %1%2,?rich)
				end
			end

			- $content
		end
	end
end

let fontList = do
	- mathjax-newcm
	- mathjax-asana
	- mathjax-bonum
	- mathjax-dejavu
	- mathjax-fira
	- mathjax-modern
	- mathjax-pagella
	- mathjax-schola
	- mathjax-stix2
	- mathjax-termes
	- mathjax-tex
end

let extensionFontList = do
	- mathjax-euler
	- mathjax-bbm
	- mathjax-bboldx
	- mathjax-dsfont
end

// Change mathjax font for the whole document
setMathFont: macro(name)
	if not Table.find(fontList, name)
		@plume.warning Unknown font "$name".
	end
	@Table.append($global.scriptToAppend)
		@html.Script
			MathJax.output = MathJax.output || {};\n
			MathJax.output.font = "$name";
		end
	end
end

setMathFontExtension: macro(name)
	if not Table.find(extensionFontList, name)
		@plume.warning Unknown font extension "$name".
	end
	@Table.append($global.scriptToAppend)
		@html.Script
			MathJax.output = MathJax.output || {};\n
			MathJax.output.fontExtensions = ["$name"];
		end
	end
end