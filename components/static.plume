let html = $import(html)
let css  = $import(css)
let global = $import(../global)

ref Style: macro(content)
	$ Table.append(global.styleToAppend, content)
end

Script: macro(...args)
	$ Table.append(global.scriptToAppend, html.Script(...args))
end

Rule: $css.Rule

// `path` must be an `os.Path` object targeting a directory.
loadFont: macro(path)
	$ Table.append(global.fontsToLoad, path)
end

let scopeCount = 0

// Intended to be used inside a Scope element instead of Rule.
ref ScopeRule: macro(selectors, ...rules)
	@css.Rule
		- @Table.join(sep:\,\s)
			for selector in selectors.split(sep: ",")
				- &$selector\, & $selector
			end
		end
		...rules
	end
end

// Apply a set of rule to the given element. Dont affect html structure
ref Scope: macro(content, rules:, selector:, ...attrs)
	set scopeCount += 1
	if rules
		if selector
			raise "selector" it isn't compatible with "rules".
		end

		@Style
			@css.Rule(.pages--scope-$scopeCount)
				if type(rules) == "table"
					$ css.css(...rules)
				else
					$rules
				end
			end
		end
	elseif selector
		@Style
			@css.Rule(.pages--scope-$scopeCount)
				@css.Rule($selector)
					$ css.css(...attrs)
				end
			end
		end
		
	else
		raise You must provide at leat "rules" or "selector".
	end

	$html.Span($empty, class: pages--scope-begin, dataScope: $scopeCount)
	$content
	$html.Span($empty, class: pages--scope-end, dataScope: $scopeCount)
end

// Internal — called by Document/clean
staticClean: macro()
	set scopeCount = 0
end
