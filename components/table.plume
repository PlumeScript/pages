use #rawNumbers

let html = $import(html)

ref colspan: $Table()
ref rowspan: $Table()

// Make a table from a List of Lists
// You can provide an `header` key with the first row as value.
// `?zebra` alternates row colors.
// User $colspan and $rowspan variable BEFORE the cell to expand.
// **Example:** ```@Table\n    header: (id, name, price)\n    - (1, Apple, 2€)\n    - (2, Orange, 3€)\nend```
Table: macro(?zebra, ...rows)
	@html.Table(class: pages--table $(zebra and "pages--table--zebra"))
		if rows.header?
			if type(rows.header) != "table"
				raise Header must be "table", not "$type($rows.header)".
			end
			@html.Thead(class: pages--table--row pages--table--row-header)
				@html.Tr(class: pages--table--row)
					for cell in rows.header
						@html.Th(class: pages--table--cell pages--table--cell-header)
							$cell
						end
					end
				end
			end
		end

		let rowspanCollector = $Table()

		for  row in rows
			if type(row) != "table"
				raise Table element must be "table", not "$type($row)".
			end
			
			let colspanCount = 1
			@html.Tr(class: pages--table--row)
				for i, cell in  enumerate(row)
					if cell == colspan
						set colspanCount += 1
					elseif rowspanCollector[i]?
						set rowspanCollector[i].count += 1
						if cell != rowspan
							set rowspanCollector[i].content = $cell
							set rowspanCollector[i] = $empty
						end
					elseif cell == rowspan
						let infos = (count: 1, content: begin)
						set rowspanCollector[i] = $infos
						let t = do
							meta fragment: macro()
								@html.Td
									class: pages--table--cell
									rowspan: $infos.count
									- $infos.content
								end
							end
						end
						$t
					else
						@html.Td
							class: pages--table--cell
							if colspanCount>1
								colspan: $colspanCount
							end
							- $cell
						end
						set colspanCount = 1
					end
				end
			end
		end
	end
end
