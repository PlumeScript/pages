use #rawNumbers

let html = $import(html)

// Make a table from a List of Lists
// You can provide an `header` key with the first row as value.
// `?zebra` alternates row colors.
// **Example:** ```@Table\n    header: (id, name, price)\n    - (1, Apple, 2€)\n    - (2, Orange, 3€)\nend```
Table: macro(?zebra, ...rows)
	@html.Table(class: pages--table $(zebra and "pages--table--zebra"))
		if rows.header?
			if type(rows.header) != "table"
				raise Header must be "table", not "$type($rows.header)".
			end
			@html.Thead(class: pages--table--row pages--table--row-header)
				@html.Tr(class: pages--table--row)
					for cell in rows.header
						@html.Th(class: pages--table--cell pages--table--cell-header)
							$cell
						end
					end
				end
			end
		end

		for row in rows
			if type(row) != "table"
				raise Table element must be "table", not "$type($row)".
			end
			
			@html.Tr(class: pages--table--row)
				for cell in row
					@html.Td(class: pages--table--cell)
						$cell
					end
				end
			end
		end
	end
end
