let html = $import(html)
Par: $html.P

bold: macro(content)
	$html.Span($content, class: pages--text--bold)
end

italic: macro(content)
	$html.Span($content, class: pages--text--italic)
end

underline: macro(content)
	$html.Span($content, class: pages--text--underline)
end

striped: macro(content)
	$html.Span($content, class: pages--text--striped)
end