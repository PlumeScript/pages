use #rawNumbers

let html = $import(html)
let context = $import(../context)
let global = $import(../global)
let applyFormatNumbering from $import(../utils/counterLabel)

let numberTracking = (0, 0, 0, 0, 0, 0)
let lastRef

applyFormatNumbering: $applyFormatNumbering
// Set the numbering counter of a heading level.
headingSetCounter: macro(level, Number value)
	if value<=0
		raise value must be greater than 0
	end
	if level<=0 or level>6
		raise level must be between 1 and 6
	end
	set numberTracking[level] = $value
end

// Section heading, auto-numbered.
// `marker:` see **Numbering Format**.
// `?hideNumbering` hides the number, `?noNumbering` disables counting.
ref heading: macro(String title, Number level: 1, marker:, ?hideNumbering, ?noNumbering, ?hideFromTOC)
	let formatNumbering
	if marker != "auto"
		set formatNumbering = $marker
	end

	if level<1 or level>6
		raise Level must be between 1 and 6, not $level.
	end
	if hideNumbering and noNumbering
		raise `?noNumbering` and `?hideNumbering` flags are incompatibles.
	end

	if not noNumbering
		for i in seq(level+1, 6)
			set numberTracking[i] = 0
		end
		set numberTracking[level] += 1
	end

	let numbering
	let rawTitle = $title
	if not hideNumbering and not noNumbering
		set numbering = $applyFormatNumbering($level, $formatNumbering, $numberTracking)
		set title = do
			@html.Span(class: pages--title-number)
				$numbering
			end
			@html.Span(class: pages--title-body)
				$title
			end
		end
	end

	let id = if not noNumbering
		heading-$Table.join(sep:_, ...numberTracking)
	else
		heading-$title.replace([<>"'%s],-,?rich)
	end

	if not hideFromTOC
		run $ Table.append(global.tocContent, (level: level, content: title, id: id))
	end

	set lastRef = (anchor: #$id, numbering: $numbering, title: $rawTitle)
	let key = H$level
	return $ html[key](title, id: id)
end

// Return informations about last heading as table with fields:
// `anchor`: to make intern jumps, like `$link(this section, $ref.anchor)`
// `numbering`: formated numbering, if any.
// `title`
getHeadingRef: macro()
	if not lastRef
		raise No ref was defined.
	end

	return $lastRef
end

// alias for `heading(..., level: 1)`
chapter: macro(...args)
	set args.level = 1
	$heading(...args)
end

// alias for `heading(..., level: 2)`
section: macro(...args)
	set args.level = 2
	$heading(...args)
end

// alias for `heading(..., level: 3)`
subsection: macro(...args)
	set args.level = 3
	$heading(...args)
end

// alias for `heading(..., level: 4)`
subsubsection: macro(...args)
	set args.level = 4
	$heading(...args)
end