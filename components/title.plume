use #future(all)
let html = $import(html)
let context = $import(../context)
let applyFormatNumbering from $import(../utils/counterLabel)

let numberTracking = (0, 0, 0, 0, 0, 0)

headingSetCounter: macro(level, Number value)
	if value<=0
		raise value must be greater than 0
	end
	if level<=0 or level>6
		raise level must be between 1 and 6
	end
	set numberTracking[level] = $value
end

ref heading: macro(String title, Number level: 1, formatNumbering:, fn:, ?hideNumbering, ?noNumbering)
	if level<1 or level>6
		raise Level must be between 1 and 6, not $level.
	end
	if hideNumbering and noNumbering
		raise `?noNumbering` and `?hideNumbering` flags are incompatibles.
	end

	if formatNumbering and fn
		raise Cannot use both "formatNumbering" and "c" fn.
	end
	set formatNumbering = $ formatNumbering or fn

	if not noNumbering
		for i in seq(level+1, 6)
			set numberTracking[i] = 0
		end
		set numberTracking[level] += 1
	end

	if not hideNumbering and not noNumbering
		set title = do
			@html.Span(class: page--title-number)
				$applyFormatNumbering($level, $formatNumbering, $numberTracking)
			end
			@html.Span(class: page--title-body)
				$title
			end
		end
	end

	let key = H$level
	if level <= 2
		$html[key]($title, class: pages--to-space)
	else
		$html[key]($title)
	end
end

for level in seq(6)
	let key = H$level
	key: macro(args)
		set args.level = $level
		$heading(...args)
	end
end