use #rawNumbers

let html = $import(html)
let var, Rule from $import(css)
let initPageFormat = $import(./initPageFormat)
let context = $import(./context)
let cleanImported = $import(./utils/cleanImported)
let loadFont = $import(./utils/loadFont)
let global = $import(./global)

for component in os.Path("./components").walk()
	...import($String($component).replace(.plume, $("")))
end

pagesContext: $context

// `path` must be an `os.Path` object targeting a directory.
loadFont: macro(path)
	$ Table.append(global.fontsToLoad, path)
end

// Called at document start
ref makeStyle: macro(pageFormat:, ?landscape)
	@html.Style
		for path in global.fontsToLoad
			$ loadFont(path)
		end
		if pageFormat
			@Rule(:root)
				...initPageFormat($pageFormat, landscape: $landscape)

				$var(pageMarginTop):    30mm
				$var(pageMarginBottom): 30mm
				$var(pageMarginLeft):   30mm
				$var(pageMarginRight):  30mm
				$var(pageMarginGutter): 10mm
			end
		end
		
		for stylesheet in os.Path("./static/css").walk()
			if stylesheet.isFile() and (pageFormat or not String(stylesheet).find("/page/"))
				$cleanImported($stylesheet.read())
			end
		end
	end
end

// Pagination: auto, enable, disable, x, x-y
// Gutter: auto, enable, disable
Document: macro(content, filename:, title:, pageFormat: A4, lang:, pagination: auto, gutter: auto, ?landscape)
	if filename
		if not filename.find("%.html^", ?rich)
			set filename = $filename\0.html
		end
	end

	if (context.titleFont() == "Lora" or context.bodyFont() == "Lora")
		run $Table.append($global.fontsToLoad, $os.Path(./static/fonts/Lora))
	end
	if (context.monoFont() == "FiraCode")
		run $Table.append($global.fontsToLoad, $os.Path(./static/fonts/FiraCode))
	end

	let result = do
		@html.Html(lang: $(lang or plume.locale() or "en"))
			@html.Head
				$html.Meta(charset: UTF-8, ?noClose)
				if global.documentAuthor
					$html.Meta(name: author, content: $global.documentAuthor, ?noClose)
				end
				set title = $ title or global.documentTitle or filename
				if title
					$html.Title($title)
				end
				$makeStyle(pageFormat: $pageFormat, landscape: $landscape)

				$html.Script($empty, src: https:/\/cdn.jsdelivr.net/npm/mathjax\@4/tex-mml-svg.js, ?defer)
			end

			@html.Body
				if gutter == "enable" or gutter == "auto" and pagination != "disable"
					class: pages--gutter
				end
				- $content
			end

			@html.Script
				\0let paginationConfig = "$pagination";\n
				for script in os.Path("./static/js").walk()
					if script.isFile()
						$cleanImported($script.read())
					end
				end
			end
		end
	end

	if filename
		run $ os.Path(filename).write(result)
	end
	
	return $result
end