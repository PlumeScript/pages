use #rawNumbers

let var from $import(css)

macro(String pageFormat, ?landscape, ?imposeBooklet)
	let w,  h

	if pageFormat.sub(1, 1) == "A"
		set w, h = (1189, 841)
	else
		raise Unknown page format "$pageFormat"
	end

	let subdiv = $(Number(pageFormat.sub(2, 2)))

	for i in seq(subdiv)
		set w /= 2
		set w, h = ($h, $w)
	end

	if landscape and w<h or not landscape and w>h
		set w, h = ($h, $w)
	end

	$var(pageWidth):  $w\0mm
	$var(pageHeight): $h\0mm

	if imposeBooklet
		// Sheet: two pages laid along the fold axis
		let sw, sh
		if w>h
			set sw, sh = ($w, $(2*h))
		else
			set sw, sh = ($(2*w), $h)
		end
		$var(sheetWidth):  $sw\0mm
		$var(sheetHeight): $sh\0mm
	end
end