use #future(all)
use .

macro capitalize(s)
  $s.sub(1).upper()$s.sub(2, -1)
end

macro escapeHTML(s)
	set s = $String($s)
	$s.replace(&, &amp;).replace(<, &lt;).replace(>, &gt;).replace(", &quot;)
end

macro formatLine(line)
	set line = $line.replace(```(.-)```, macro (x) $BlockCode($x),?rich)
	set line = $line.replace(`(.-)`, macro (x) $code($x),?rich)
	set line = $line.replace(%*%*(.-)%*%*, macro (x) $bold($x),?rich)
	set line = $line.replace(%*(.-)%*, macro (x) $italic($x),?rich)
	set line = $line.replace(\\n, \n)
	return $line
end

@Document(filename: ./doc/doc, title: Plume Pages Documentation)
	$vfill
    @MainTitle
		title: $image($os.Path(./logo.svg)) Documentation
		subtitle: v0.3.0
	end

    $vfill
    $newpage
	$chapter(Global mechanisms)
		$section(Paginations)
			Rendering splits the body into fixed-size pages that match the page format (size and margins).
			$par
			An element that does not fit moves whole to the next page — it is never split across pages.
			$par
			Page breaks are driven by CSS fragmentation properties:
			@List(marker: arrow)
				- $code(break-before\: page) starts a new page ($code(newpage) is the ready-made marker)
				- $code(break-after\: page) makes the following content start on a new page
				- $code(break-after\: avoid) keeps the element with the next one (no orphan heading)
		  	end
			$par
			$code(.pages--page) is generated by the engine — never add it manually or pagination is skipped.

		$section(Paragraphs)
			Runs of inline content are auto-wrapped in $code(p) by a JS pass, in the body and in every nested flow container ($code(.pages--to-flow)).
			$par
			A block element ends the paragraph; $code(\$par) forces a paragraph break.
			$par
			A display formula is marked $code(.pages--as-inline) so it stays in its sentence, and pagination never splits them.
			$par
			Plume strips blank lines, so two paragraphs of plain text joined by a blank line are concatenated. Separate them with $code(\$par).

		$section(Spacing)
			Block components meant to be followed by flexible space carry $code(.pages--to-space) — headings, $code(hline), $code(Blockquote), $code(MainTitle).
			$par
			A JS pass inserts a bounded spacer before each $code(.pages--to-space) and as the last element of every page, absorbing leftover space up to $code(--vspace-max).
			$par
			Manual spacers\: $code(hspace) (horizontal), $code(vspace) (bounded), $code(vfill) (fills the page).

		$section(Numbering Format)
			Headings and ordered lists number automatically from per-level counters.
			$glue
			The format is a string over a few tokens\:
            $par
			@List(marker: arrow)
				- $code(1) decimal, $code(a) and $code(A) lowercase and uppercase letters, $code(i) and $code(I) roman numerals
				- $code(*) renders the parent level (forbidden at level 1)
			end
			$par
			Compose tokens freely, e.g. $code(a.), $code(1.), $code(*.1).
			$par
			The default per level is set by the contextual variables $code(formatNumbering1) to $code(formatNumbering6).

	$chapter(List of components)
        $section(Document)
          	$bold(Usage)\: $code(Document $plume.doc($Document).signature)$par
        $section(LoadFont)
          	$bold(Usage)\: $code(loadFont $plume.doc($loadFont).signature)$par
          	@Blockquote
				for line in plume.doc(loadFont).doc.lines()
					$ formatLine(line)
					$par
				end
			end
		for component in os.Path("./components").walk()
			$ section(capitalize(component.getStem()))
			for name, elem in items(component.import())
				$subsection($italic($type($elem)) $name, ?hideNumbering)
				if type(elem) == "macro"
					let infos = $ plume.doc(elem)
					@Par
						$bold(Usage)\: $code($name $infos.signature)$par
						if len(infos.doc) > 0
                            $glue
							@Blockquote
								for line in infos.doc.lines()
									$ formatLine(line)
									$par
								end
							end
						end
					end
				elseif type(elem) == "string"
					Value\: $code($escapeHTML($elem))
				end
			end
		end
	
	$chapter(List of contextual variables)
	@Table
		header: (Name, Default value)
		for name, value in items(import("context"))
			- ($name, $value())
		end
	end
end