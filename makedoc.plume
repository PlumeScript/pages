use #rawNumbers

use html, css
use .

macro capitalize(String s)
  $s.sub(1).upper()$s.sub(2, -1)
end

macro escapeHTML(String s)
	$s.replace(&, &amp;).replace(<, &lt;).replace(>, &gt;).replace(", &quot;)
end

macro formatLine(line)
	set line = $line.replace(```(.-)```, macro (x) $BlockCode($x),?rich)
	set line = $line.replace(`(.-)`, macro (x) $code($x),?rich)
	set line = $line.replace(%*%*(.-)%*%*, macro (x) $bold($x),?rich)
	set line = $line.replace(%*(.-)%*, macro (x) $italic($x),?rich)
	set line = $line.replace(\\n, \n)
	return $line
end

let version = v0.6.0

@Document(filename: ./doc/doc, title: Plume Pages Documentation, pagination: 3)
    @Style
      @Rule(h1)
        background: linear-gradient(20deg, #000, #00ccff 50%)
        $("-webkit-background-clip"): text
        $("-webkit-text-fill-color"): transparent
      end
    end
	$vfill
    @MainTitle
		title: $image($os.Path(./logo.svg)) Documentation
		subtitle: $version
	end
    $vfill

    @Header(?excludeFirst)
      left: Plume Pages Documentation
    end
    
    @Footer(?excludeFirst)
      center: $version
    end

    $whitePage
    $tableOfContents(title: Table of contents)
    $newpage
    
	$chapter(Quick Start)
    $chapter(Global mechanisms)
		$section(Document)
			The macro $code(Document)$newpar
			$bold(Usage)\: $code(Document $plume.doc($Document).signature)$newpar
			is the main entry point of your document.$newpar
			
			Provide $code(filename) to automatically save output without using $code(plume -o).$newpar
			$newpar
			The state produced by the content (title, author, loaded fonts, appended styles and scripts, table of contents, numbering counters) is shared between the documents of the same process. It is automatically reset at the end of every $code(Document), so consecutive documents do not leak into each other. See $code(clean) to reset it manually.
		
		$section(clean)
			The macro $code(clean)$newpar
			$bold(Usage)\: $code($plume.doc($clean).signature)$newpar
			Resets all the shared document state: global title and author, loaded fonts, appended styles and scripts, table of contents, numbering counters, last heading reference and scope counter.$newpar
			It is called automatically at the end of every $code(Document), so consecutive documents start from a pristine state.$newpar
			Call it manually between two documents when the shared state was manipulated outside of a $code(Document) call, after an error that left the state dirty, or in a generation loop.
		
		$section(Paginations)
			Rendering splits the body into fixed-size pages that match the page format (size and margins).
			$newpar
			An element that does not fit moves whole to the next page — it is never split across pages.
			$newpar
			You can force a page-break with $code(\$newpage) and prevent two elements from being separated by using $code(\$glue) between them.

		$section(Paragraphs)
			Runs of inline content are auto-wrapped in paragraphs. You can force a par-break with $code(\$newpar), and force a newline - without par-break - with $code(\$newline).

		$section(Numbering Format)
			Numbering format of titles and lists recognizes a few special escapes:
            $glue
			@List(marker: arrow)
				- $code(%1) for decimal
				- $code(%a) and $code(%A) for lowercase/uppercase letters.
				- $code(%i) and $code(%I) for lowercase/uppercase roman numerals.
				- $code(%*) to render the parent level.
                - $code(%p) for literal $code(%).
			end
			@italic
				Note\: $code(%*) is forbidden at level 1 ($code(\$heading(...\, level: 1)) and $code(\$chapter(...)))
			end
            $newpar

			$bold(Example)\: if the parent is rendered as $code(II>c) and the pattern for the sub level is $code(%*>%1), 3rd child will be numbered as $code(II>c>3).
			
			$newpar$glue
			
			The default values are set by the contextual variables $code(formatNumbering1) to $code(formatNumbering6).

	$chapter(Components)
    $chapter(List of exposed variables)
		for component in os.Path("./components").walk()
			$ section(capitalize(component.getStem()))
			for name, elem in items(component.import())
				$subsection($italic($type($elem)) $name, ?hideNumbering)
				if type(elem) == "macro"
					let infos = $ plume.doc(elem)
					$bold(Usage)\: $code($name $infos.signature)$newpar
					if len(infos.doc) > 0
                          $glue
						@Blockquote
							for line in infos.doc.lines()
								$ formatLine(line)
								$newpar
							end
						end
					end
				elseif type(elem) == "string"
					Value\: $code($escapeHTML($elem))
				end
			end
		end
	
	$chapter(List of contextual variables)
		@Table
			header: (Name, Default value)
			for name, value in items(import("context"))
				- ($code(pagesContext.$name), $code($value()))
			end
		end
end