use #rawNumbers

// Workaround: os.Path.write doesn't support binary mode, and Plume is missing bytes manipulation features
macro(path)
	let strpath = $ String(path)
	let cachePath = $os.Path(../static/.cache/$strpath.replace(-, --).replace([/\\:], -, ?rich))
	
	if cachePath.exists() and cachePath.getModification() > path.getModification()
		return $cachePath.read()
	end
	let b64 = @lua.eval
		local path = "$strpath"
		raw[
			local f = io.open(path, "rb")
			if not f then
				error(string.format("Cannot read '%s' content.", path))
			end
			local data = f:read("*a")
			f:close()

			local bit = require("bit")
			local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
			local out = {}
			local i = 1
			local n = #data
			while i <= n do
				local a = data:byte(i)
				local b = data:byte(i + 1)
				local c = data:byte(i + 2)
				out[#out + 1] = chars:sub(bit.rshift(a, 2) + 1, bit.rshift(a, 2) + 1)
				out[#out + 1] = chars:sub(bit.bor(bit.lshift(bit.band(a, 3), 4), bit.rshift(b or 0, 4)) + 1, bit.bor(bit.lshift(bit.band(a, 3), 4), bit.rshift(b or 0, 4)) + 1)
				if b then
					out[#out + 1] = chars:sub(bit.bor(bit.lshift(bit.band(b, 15), 2), bit.rshift(c or 0, 6)) + 1, bit.bor(bit.lshift(bit.band(b, 15), 2), bit.rshift(c or 0, 6)) + 1)
				else
					out[#out + 1] = "="
				end
				if c then
					out[#out + 1] = chars:sub(bit.band(c, 63) + 1, bit.band(c, 63) + 1)
				else
					out[#out + 1] = "="
				end
				i = i + 3
			end

			return table.concat(out)
		]end
	end

	run $ cachePath.write(b64)
	return $b64
end